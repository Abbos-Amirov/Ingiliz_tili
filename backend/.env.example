PORT=5051
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inglizTili?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-string>
JWT_EXPIRES_IN=7d
ENGLISH_AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY is still accepted as a fallback if ENGLISH_AI_API_KEY is not set
CORS_ORIGIN=http://localhost:5050
# Comma-separated list of allowed origins is supported, e.g. http://localhost:5050,http://localhost:3001
NODE_ENV=development
# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID,
# type "Web application"). Only the client ID is used server-side (to verify
# the ID token's audience) — GOOGLE_CLIENT_SECRET isn't needed by this app.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
